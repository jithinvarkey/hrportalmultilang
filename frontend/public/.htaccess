<IfModule mod_mime.c>
    AddType application/javascript .mjs
</IfModule>

# Angular routes (/policies, /leave, …): serve index.html for any path that is not a real file or folder,
# so refreshing a page or opening a direct link works instead of returning 404.
# /api, /sanctum, /login and /logout are proxied to the backend in the Apache vhost before this file applies.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # index.html is always revalidated, so browsers pick up a new build right away
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>
    # Build files with a content hash in the name (main-XXXXXXXX.js, chunk-XXXXXXXX.js, styles-XXXXXXXX.css) never change
    <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
